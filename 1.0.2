<!-- ════════ SCRIPT ════════ -->
<script type="module">
import { initializeApp }        from "https://www.gstatic.com/firebasejs/12.10.0/firebase-app.js";
import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword,
         signOut, onAuthStateChanged, sendPasswordResetEmail }
    from "https://www.gstatic.com/firebasejs/12.10.0/firebase-auth.js";
import { getFirestore, doc, setDoc, getDoc, deleteDoc,
         collection, query, onSnapshot, getDocs, updateDoc, writeBatch, orderBy }
    from "https://www.gstatic.com/firebasejs/12.10.0/firebase-firestore.js";

// ── Config ────────────────────────────────────────────────────
const firebaseConfig = {
    apiKey: "AIzaSyD2YcojERxTnmMLY30Xnvde2uozu0X4UOw",
    authDomain: "flashcard-app-2a3a5.firebaseapp.com",
    projectId: "flashcard-app-2a3a5",
    storageBucket: "flashcard-app-2a3a5.firebasestorage.app",
    messagingSenderId: "886129894816",
    appId: "1:886129894816:web:1a1a1357a09d472d09b0c5"
};
const firebaseApp = initializeApp(firebaseConfig);
const auth = getAuth(firebaseApp);
const db   = getFirestore(firebaseApp);

// ── État global ───────────────────────────────────────────────
let currentUser      = null;
let isAdmin          = false;
let localData        = { lists: [] };
let allUsersCache    = [];       // cache pour le panel admin
let unsubscribeLists = null;
let currentListId    = null;
let currentCardIndex = 0;
let isFlipped        = false;
let editingCardId    = null;
let sessionCorrect   = 0;
let sessionIncorrect = 0;
let sessionResults   = [];
let savingTimer      = null;
// Pour admin : utilisateur sélectionné
let adminViewingUser = null;    // { uid, email, ... }
let adminViewingList = null;    // liste sélectionnée

// ── DOM helpers ───────────────────────────────────────────────
function setTextSafe(el, text) {
    if (typeof el === 'string') el = document.getElementById(el);
    if (el) el.textContent = String(text ?? '');
}
function createEl(tag, props = {}, children = []) {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) {
        if (k === 'className') el.className = v;
        else if (k === 'style' && typeof v === 'object') Object.assign(el.style, v);
        else if (k.startsWith('on') && typeof v === 'function') el.addEventListener(k.slice(2).toLowerCase(), v);
        else el.setAttribute(k, v);
    }
    for (const child of children) {
        if (child == null) continue;
        el.appendChild(typeof child === 'string' ? document.createTextNode(child) : child);
    }
    return el;
}
function generateId() {
    return crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2);
}

// ── Dialog ────────────────────────────────────────────────────
function showAlert(title, message, onOk) {
    setTextSafe('dialogTitle', title);
    setTextSafe('dialogMessage', message);
    const a = document.getElementById('dialogActions'); a.innerHTML = '';
    a.appendChild(createEl('button', { className: 'btn btn-primary', onClick: () => { closeDialog(); onOk?.(); } }, ['OK']));
    document.getElementById('dialogOverlay').classList.add('active');
}
function showConfirm(title, message, onConfirm, onCancel) {
    setTextSafe('dialogTitle', title);
    setTextSafe('dialogMessage', message);
    const a = document.getElementById('dialogActions'); a.innerHTML = '';
    a.appendChild(createEl('button', { className: 'btn btn-secondary', onClick: () => { closeDialog(); onCancel?.(); } }, ['Annuler']));
    a.appendChild(createEl('button', { className: 'btn btn-danger',    onClick: () => { closeDialog(); onConfirm?.(); } }, ['Confirmer']));
    document.getElementById('dialogOverlay').classList.add('active');
}
function closeDialog() { document.getElementById('dialogOverlay').classList.remove('active'); }
window.closeDialog = closeDialog;

// ── Saving indicator ──────────────────────────────────────────
function showSaving() {
    const el = document.getElementById('savingIndicator');
    el.classList.add('visible');
    clearTimeout(savingTimer);
    savingTimer = setTimeout(() => el.classList.remove('visible'), 1800);
}

// ── Firestore refs ────────────────────────────────────────────
const userListsRef  = (uid)          => collection(db, 'users', uid, 'lists');
const listDocRef    = (uid, listId)  => doc(db, 'users', uid, 'lists', listId);
const userProfileRef = (uid)         => doc(db, 'users', uid, 'profile', 'data');
const adminDocRef   = (uid)          => doc(db, 'admins', uid);

async function saveListToFirestore(list, uid = null) {
    showSaving();
    const targetUid = uid || currentUser.uid;
    try {
        await setDoc(listDocRef(targetUid, list.id), {
            name: list.name, cards: list.cards,
            createdAt: list.createdAt, updatedAt: new Date().toISOString()
        });
    } catch(e) {
        console.error('Firestore save error:', e);
        showAlert('❌ Erreur', 'Impossible de sauvegarder : ' + e.message);
    }
}
async function deleteListFromFirestore(listId, uid = null) {
    showSaving();
    const targetUid = uid || currentUser.uid;
    try { await deleteDoc(listDocRef(targetUid, listId)); } catch(e) { console.error(e); }
}

// ── Profil utilisateur ────────────────────────────────────────
async function saveUserProfile(user) {
    try {
        await setDoc(userProfileRef(user.uid), {
            email: user.email,
            uid: user.uid,
            lastLogin: new Date().toISOString(),
            blocked: false,
        }, { merge: true });
    } catch(e) { console.error('Profile save error:', e); }
}

async function checkIfBlocked(uid) {
    try {
        const snap = await getDoc(userProfileRef(uid));
        return snap.exists() && snap.data().blocked === true;
    } catch(e) { return false; }
}

async function checkIfAdmin(uid) {
    try {
        const snap = await getDoc(adminDocRef(uid));
        return snap.exists();
    } catch(e) { return false; }
}

// ── Auth listener ─────────────────────────────────────────────
onAuthStateChanged(auth, async (user) => {
    if (user) {
        // Vérifier si bloqué
        const blocked = await checkIfBlocked(user.uid);
        if (blocked) {
            await signOut(auth);
            document.getElementById('globalLoader').classList.add('hidden');
            showAuthScreens();
            setTimeout(() => showAlert('🚫 Accès refusé', 'Votre compte a été bloqué par un administrateur. Contactez le support.'), 300);
            return;
        }

        currentUser = user;
        isAdmin     = await checkIfAdmin(user.uid);

        // Mettre à jour le profil
        await saveUserProfile(user);

        // UI
        document.getElementById('globalLoader').classList.add('hidden');
        document.getElementById('authWrapper').style.display = 'none';
        document.getElementById('mainApp').style.display = 'flex';
        setTextSafe('headerUserEmail', user.email);
        setTextSafe('settingsUserEmail', user.email);

        // Bouton admin
        document.getElementById('adminHeaderBtn').style.display = isAdmin ? 'flex' : 'none';

        // Header couleur admin
        const header = document.getElementById('mainHeader');
        if (isAdmin) header.classList.add('admin-header');
        else header.classList.remove('admin-header');

        subscribeToLists();
        showScreen('homeScreen');
        renderLists();
    } else {
        currentUser = null;
        isAdmin     = false;
        if (unsubscribeLists) { unsubscribeLists(); unsubscribeLists = null; }
        localData = { lists: [] };
        document.getElementById('globalLoader').classList.add('hidden');
        showAuthScreens();
    }
});

function showAuthScreens() {
    document.getElementById('mainApp').style.display = 'none';
    document.getElementById('authWrapper').style.display = 'block';
    document.getElementById('loginScreen').style.display = 'block';
    document.getElementById('registerScreen').style.display = 'none';
}

// ── Auth functions ────────────────────────────────────────────
function showAuthError(id, msg) { const el = document.getElementById(id); setTextSafe(el, msg); el.classList.add('visible'); }
function clearAuthError(id) { document.getElementById(id).classList.remove('visible'); }
function setAuthLoading(btnId, loading) {
    const btn = document.getElementById(btnId); btn.disabled = loading;
    btn.textContent = loading ? '…' : (btnId === 'loginBtn' ? 'Se connecter' : 'Créer mon compte');
}
window.showLogin    = () => { document.getElementById('registerScreen').style.display='none'; document.getElementById('loginScreen').style.display='block'; };
window.showRegister = () => { document.getElementById('loginScreen').style.display='none'; document.getElementById('registerScreen').style.display='block'; };

window.doLogin = async () => {
    clearAuthError('loginError');
    const email = document.getElementById('loginEmail').value.trim();
    const pwd   = document.getElementById('loginPassword').value;
    if (!email || !pwd) { showAuthError('loginError','Veuillez remplir tous les champs.'); return; }
    setAuthLoading('loginBtn', true);
    try { await signInWithEmailAndPassword(auth, email, pwd); }
    catch(e) { setAuthLoading('loginBtn', false); showAuthError('loginError', friendlyAuthError(e.code)); }
};

window.doRegister = async () => {
    clearAuthError('registerError');
    const email = document.getElementById('registerEmail').value.trim();
    const pwd   = document.getElementById('registerPassword').value;
    const conf  = document.getElementById('registerPasswordConfirm').value;
    if (!email || !pwd)   { showAuthError('registerError','Veuillez remplir tous les champs.'); return; }
    if (pwd !== conf)      { showAuthError('registerError','Les mots de passe ne correspondent pas.'); return; }
    if (pwd.length < 6)    { showAuthError('registerError','Minimum 6 caractères.'); return; }
    setAuthLoading('registerBtn', true);
    try { await createUserWithEmailAndPassword(auth, email, pwd); }
    catch(e) { setAuthLoading('registerBtn', false); showAuthError('registerError', friendlyAuthError(e.code)); }
};

window.doLogout = () => showConfirm('Se déconnecter','Voulez-vous vraiment vous déconnecter ?', () => signOut(auth));

window.doResetPassword = async () => {
    const email = document.getElementById('loginEmail').value.trim();
    if (!email) { showAuthError('loginError','Entrez votre email pour réinitialiser votre mot de passe.'); return; }
    try { await sendPasswordResetEmail(auth, email); showAlert('📧 Email envoyé',`Un lien a été envoyé à ${email}.`); }
    catch(e) { showAuthError('loginError', friendlyAuthError(e.code)); }
};

function friendlyAuthError(code) {
    return { 'auth/user-not-found':'Aucun compte trouvé.', 'auth/wrong-password':'Mot de passe incorrect.', 'auth/invalid-credential':'Email ou mot de passe incorrect.', 'auth/email-already-in-use':'Email déjà utilisé.', 'auth/invalid-email':'Email invalide.', 'auth/weak-password':'Mot de passe trop faible.', 'auth/too-many-requests':'Trop de tentatives. Réessayez plus tard.', 'auth/network-request-failed':'Erreur réseau.' }[code] || 'Une erreur est survenue.';
}

// ── Navigation ────────────────────────────────────────────────
function showScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
}
window.showScreen = showScreen;

function showHomeScreen() { showScreen('homeScreen'); currentListId = null; renderLists(); }
window.showHomeScreen = showHomeScreen;

// ── Listes (utilisateur courant) ──────────────────────────────
function subscribeToLists() {
    if (unsubscribeLists) unsubscribeLists();
    unsubscribeLists = onSnapshot(query(userListsRef(currentUser.uid)), snap => {
        localData.lists = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        if (document.getElementById('homeScreen').classList.contains('active')) renderLists();
    });
}

function getList(listId) { return localData.lists.find(l => l.id === listId); }

function renderLists() {
    const container = document.getElementById('listContainer'); container.innerHTML = '';
    if (localData.lists.length === 0) {
        container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['📋']),createEl('div',{className:'empty-state-title'},['Aucune liste créée']),createEl('p',{},['Cliquez sur + pour créer votre première liste'])]));
        return;
    }
    for (const list of localData.lists) {
        const cards = list.cards || [];
        const knownCount = cards.filter(c=>(c.srsLevel||0)>=2).length;
        const learningCount = cards.filter(c=>(c.srsLevel||0)===1).length;
        const newCount = cards.length - knownCount - learningCount;
        const card = createEl('div',{className:'card'});
        const hdr = createEl('div',{className:'card-header'});
        const tb = createEl('div');
        tb.appendChild(createEl('div',{className:'card-title'},[list.name]));
        tb.appendChild(createEl('div',{className:'card-info'},[`${cards.length} carte${cards.length!==1?'s':''}`]));
        const badges = createEl('div',{style:{marginTop:'6px',display:'flex',gap:'6px',flexWrap:'wrap'}});
        if (knownCount>0) badges.appendChild(createEl('span',{className:'srs-badge srs-known'},[`✓ ${knownCount}`]));
        if (learningCount>0) badges.appendChild(createEl('span',{className:'srs-badge srs-learning'},[`⟳ ${learningCount}`]));
        if (newCount>0) badges.appendChild(createEl('span',{className:'srs-badge srs-new'},[`★ ${newCount}`]));
        tb.appendChild(badges); hdr.appendChild(tb); card.appendChild(hdr);
        const actions = createEl('div',{className:'card-actions'});
        actions.appendChild(createEl('button',{className:'btn btn-primary',onClick:()=>startLearning(list.id)},['🎓 Apprendre']));
        actions.appendChild(createEl('button',{className:'btn btn-secondary',onClick:()=>editList(list.id)},['✏️ Modifier']));
        actions.appendChild(createEl('button',{className:'btn btn-danger btn-sm',onClick:()=>deleteListConfirm(list.id)},['🗑️']));
        card.appendChild(actions); container.appendChild(card);
    }
}

function editList(listId) {
    currentListId = listId;
    const list = getList(listId);
    setTextSafe('editListTitle', list.name);
    renderCardsInList();
    showScreen('editListScreen');
}
window.editList = editList;

function renderCardsInList() {
    const list = getList(currentListId);
    const container = document.getElementById('cardsInListContainer'); container.innerHTML = '';
    if (!list?.cards?.length) { container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['🃏']),createEl('div',{className:'empty-state-title'},['Aucune carte']),createEl('p',{},['Créez votre première carte'])])); return; }
    const srsLabels=['Nouveau','En cours','Connu']; const srsClasses=['srs-new','srs-learning','srs-known'];
    for (const card of list.cards) {
        const level=card.srsLevel||0;
        const cardEl=createEl('div',{className:'card'});
        const hdr=createEl('div',{className:'card-header'});
        const info=createEl('div',{style:{flex:'1'}});
        info.appendChild(createEl('div',{className:'card-title'},[card.front]));
        const backEl=createEl('div',{className:'card-info'}); backEl.appendChild(document.createTextNode('→ '+card.back)); info.appendChild(backEl);
        if (card.frontComment) info.appendChild(createEl('div',{style:{fontSize:'12px',fontStyle:'italic',color:'var(--text-light)',marginTop:'2px'}},[card.frontComment]));
        info.appendChild(createEl('div',{style:{marginTop:'4px',fontSize:'12px',color:'var(--text-light)'}},[`✓ ${card.correctCount||0}  ✕ ${card.incorrectCount||0}`]));
        info.appendChild(createEl('span',{className:`srs-badge ${srsClasses[level]}`,style:{marginTop:'4px'}},[srsLabels[level]]));
        hdr.appendChild(info); cardEl.appendChild(hdr);
        const actions=createEl('div',{className:'card-actions'});
        actions.appendChild(createEl('button',{className:'btn btn-secondary btn-sm',onClick:()=>openEditCardModal(card.id)},['Modifier']));
        actions.appendChild(createEl('button',{className:'btn btn-danger btn-sm',onClick:()=>deleteCardDirectConfirm(card.id)},['Supprimer']));
        cardEl.appendChild(actions); container.appendChild(cardEl);
    }
}

// ── Apprentissage ─────────────────────────────────────────────
function startLearning(listId) {
    const list = getList(listId);
    if (!list?.cards?.length) { showAlert('⚠️ Liste vide','Cette liste ne contient pas de cartes !'); return; }
    currentListId=listId; currentCardIndex=0; isFlipped=false;
    sessionCorrect=0; sessionIncorrect=0; sessionResults=[];
    setTextSafe('learningListTitle',list.name); setTextSafe('totalCards',list.cards.length);
    setTextSafe('sessionCorrect',0); setTextSafe('sessionIncorrect',0);
    displayCard(); showScreen('learningScreen');
}
window.startLearning = startLearning;

function displayCard() {
    const list=getList(currentListId); const card=list.cards[currentCardIndex];
    document.getElementById('flashcard').classList.remove('flipped'); isFlipped=false;
    setTextSafe('cardIndex',currentCardIndex+1); setTextSafe('flashcardLabel','RECTO'); setTextSafe('cardFront',card.front);
    const commentEl=document.getElementById('cardComment');
    if (card.frontComment){setTextSafe(commentEl,card.frontComment);commentEl.style.display='block';}else{commentEl.style.display='none';}
    const imgEl=document.getElementById('frontImage');
    if (card.frontImage){imgEl.src=card.frontImage;imgEl.style.display='block';}else{imgEl.style.display='none';}
    document.getElementById('progressFill').style.width=((currentCardIndex+1)/list.cards.length*100)+'%';
}

window.flipCard = () => {
    const list=getList(currentListId); const card=list.cards[currentCardIndex];
    const fc=document.getElementById('flashcard'); isFlipped=!isFlipped;
    if (isFlipped) {
        fc.classList.add('flipped'); setTextSafe('flashcardLabel','VERSO'); setTextSafe('cardFront',card.back);
        const c=document.getElementById('cardComment');
        if(card.backComment){setTextSafe(c,card.backComment);c.style.display='block';}else{c.style.display='none';}
        const img=document.getElementById('frontImage');
        if(card.backImage){img.src=card.backImage;img.style.display='block';}else{img.style.display='none';}
    } else { displayCard(); }
};
window.nextCard     = () => { const list=getList(currentListId); if(currentCardIndex<list.cards.length-1){currentCardIndex++;displayCard();}else{showSessionResults();} };
window.previousCard = () => { if(currentCardIndex>0){currentCardIndex--;displayCard();} };
window.markCardCorrect = async () => {
    const list=getList(currentListId); const card=list.cards[currentCardIndex];
    card.srsLevel=Math.min((card.srsLevel||0)+1,2); card.correctCount=(card.correctCount||0)+1; card.lastReviewed=new Date().toISOString();
    sessionCorrect++; sessionResults.push({cardId:card.id,known:true}); setTextSafe('sessionCorrect',sessionCorrect);
    await saveListToFirestore(list); window.nextCard();
};
window.markCardIncorrect = async () => {
    const list=getList(currentListId); const card=list.cards[currentCardIndex];
    card.srsLevel=0; card.incorrectCount=(card.incorrectCount||0)+1; card.lastReviewed=new Date().toISOString();
    sessionIncorrect++; sessionResults.push({cardId:card.id,known:false}); setTextSafe('sessionIncorrect',sessionIncorrect);
    await saveListToFirestore(list); window.nextCard();
};

function showSessionResults() {
    const list=getList(currentListId); const total=sessionResults.length;
    const score=total>0?Math.round((sessionCorrect/total)*100):0;
    setTextSafe('resultTotal',total); setTextSafe('resultCorrect',sessionCorrect); setTextSafe('resultIncorrect',sessionIncorrect);
    const emoji=score>=80?'🏆':score>=50?'👍':'💪'; setTextSafe('resultScore',`${emoji} Score : ${score}%`);
    const toReview=sessionResults.filter(r=>!r.known).map(r=>list.cards.find(c=>c.id===r.cardId)).filter(Boolean);
    const trl=document.getElementById('toReviewList'); trl.innerHTML='';
    if(toReview.length>0){
        trl.appendChild(createEl('h3',{style:{marginBottom:'12px',fontSize:'16px'}},[`📖 À revoir (${toReview.length})`]));
        for(const c of toReview){const item=createEl('div',{className:'card',style:{padding:'12px'}});item.appendChild(createEl('div',{style:{fontWeight:'600',marginBottom:'4px'}},[c.front]));item.appendChild(createEl('div',{style:{color:'var(--text-light)',fontSize:'13px'}},['→ '+c.back]));trl.appendChild(item);}
    }
    showScreen('resultsScreen');
}
window.restartSession = () => startLearning(currentListId);
window.endLearning    = () => showHomeScreen();

