window.closeAddCardModal = () => { document.getElementById('addCardModal').classList.remove('active'); clearCardForm(); };
function clearCardForm() {
    ['cardFrontText','cardBackText','cardFrontComment','cardBackComment'].forEach(id=>document.getElementById(id).value='');
    ['cardFrontImage','cardBackImage'].forEach(id=>document.getElementById(id).value='');
    ['frontImagePreview','backImagePreview'].forEach(id=>document.getElementById(id).innerHTML='');
}
function readFileAsDataURL(file) { return new Promise((res,rej)=>{const r=new FileReader();r.onload=e=>res(e.target.result);r.onerror=rej;r.readAsDataURL(file);}); }
function handleImagePreview(event,previewId) {
    const file=event.target.files[0]; if(!file)return;
    const reader=new FileReader(); reader.onload=e=>{const p=document.getElementById(previewId);p.innerHTML='';p.appendChild(createEl('img',{src:e.target.result,alt:'Aperçu'}));};
    reader.readAsDataURL(file);
}
document.getElementById('cardFrontImage').addEventListener('change',e=>handleImagePreview(e,'frontImagePreview'));
document.getElementById('cardBackImage').addEventListener('change',e=>handleImagePreview(e,'backImagePreview'));
document.getElementById('editCardFrontImage').addEventListener('change',e=>handleImagePreview(e,'editFrontImagePreview'));
document.getElementById('editCardBackImage').addEventListener('change',e=>handleImagePreview(e,'editBackImagePreview'));

window.addCard = async () => {
    const front=document.getElementById('cardFrontText').value.trim(); const back=document.getElementById('cardBackText').value.trim();
    if(!front||!back){showAlert('⚠️ Champs manquants','Recto et verso obligatoires');return;}
    const frontComment=document.getElementById('cardFrontComment').value.trim()||null;
    const backComment=document.getElementById('cardBackComment').value.trim()||null;
    const ff=document.getElementById('cardFrontImage').files[0]; const bf=document.getElementById('cardBackImage').files[0];
    const frontImage=ff?await readFileAsDataURL(ff):null; const backImage=bf?await readFileAsDataURL(bf):null;
    const list=getList(currentListId);
    list.cards.push({id:generateId(),front,back,frontComment,backComment,frontImage,backImage,srsLevel:0,correctCount:0,incorrectCount:0,createdAt:new Date().toISOString()});
    await saveListToFirestore(list); window.closeAddCardModal(); renderCardsInList();
};
window.openEditCardModal = (cardId) => {
    editingCardId=cardId; const list=getList(currentListId); const card=list.cards.find(c=>c.id===cardId);
    document.getElementById('editCardFrontText').value=card.front; document.getElementById('editCardBackText').value=card.back;
    document.getElementById('editCardFrontComment').value=card.frontComment||''; document.getElementById('editCardBackComment').value=card.backComment||'';
    const fp=document.getElementById('editFrontImagePreview'); const bp=document.getElementById('editBackImagePreview'); fp.innerHTML=bp.innerHTML='';
    if(card.frontImage)fp.appendChild(createEl('img',{src:card.frontImage,alt:'Aperçu'}));
    if(card.backImage)bp.appendChild(createEl('img',{src:card.backImage,alt:'Aperçu'}));
    document.getElementById('editCardModal').classList.add('active');
};
window.closeEditCardModal = () => { document.getElementById('editCardModal').classList.remove('active'); editingCardId=null; };
window.updateCard = async () => {
    const front=document.getElementById('editCardFrontText').value.trim(); const back=document.getElementById('editCardBackText').value.trim();
    if(!front||!back){showAlert('⚠️ Champs manquants','Recto et verso obligatoires');return;}
    const list=getList(currentListId); const card=list.cards.find(c=>c.id===editingCardId);
    const frontComment=document.getElementById('editCardFrontComment').value.trim()||null;
    const backComment=document.getElementById('editCardBackComment').value.trim()||null;
    const ff=document.getElementById('editCardFrontImage').files[0]; const bf=document.getElementById('editCardBackImage').files[0];
    if(ff)card.frontImage=await readFileAsDataURL(ff); if(bf)card.backImage=await readFileAsDataURL(bf);
    Object.assign(card,{front,back,frontComment,backComment});
    await saveListToFirestore(list); window.closeEditCardModal(); renderCardsInList();
};
window.confirmDeleteCard = () => showConfirm('Supprimer','Êtes-vous sûr ?',async()=>{
    const list=getList(currentListId); list.cards=list.cards.filter(c=>c.id!==editingCardId);
    await saveListToFirestore(list); window.closeEditCardModal(); renderCardsInList();
});
window.deleteCardDirectConfirm = (cardId) => showConfirm('Supprimer','Êtes-vous sûr ?',async()=>{
    const list=getList(currentListId); list.cards=list.cards.filter(c=>c.id!==cardId);
    await saveListToFirestore(list); renderCardsInList();
});

