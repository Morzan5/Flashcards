window.toggleSettings = () => { const s=document.getElementById('settingsScreen'); if(s.classList.contains('active'))showHomeScreen(); else showScreen('settingsScreen'); };
window.clearAllData   = () => showConfirm('🗑️ Tout supprimer','Supprimer toutes vos listes ?',async()=>{
    const batch=writeBatch(db); localData.lists.forEach(l=>batch.delete(listDocRef(currentUser.uid,l.id))); await batch.commit(); localData.lists=[]; showHomeScreen();
});
window.exportData = () => {
    if(!localData.lists.length){showAlert('⚠️ Rien à exporter','Aucune liste.');return;}
    const str=JSON.stringify({version:'3.0',exportedAt:new Date().toISOString(),lists:localData.lists},null,2);
    const url=URL.createObjectURL(new Blob([str],{type:'application/json'}));
    const a=createEl('a',{href:url,download:`flashcards_${new Date().toISOString().split('T')[0]}.json`});
    document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);
};
document.getElementById('importFile').addEventListener('change',function(e){
    const file=e.target.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=async ev=>{
        try {
            const data=JSON.parse(ev.target.result);
            if(!data.lists||!Array.isArray(data.lists)){showAlert('❌ Format invalide','Listes invalides.');return;}
            showConfirm('📥 Importer',`${data.lists.length} liste(s) à ajouter.`,async()=>{
                for(const il of data.lists){
                    const list={id:generateId(),name:il.name||'Sans nom',cards:(il.cards||[]).map(c=>({...c,id:generateId(),srsLevel:c.srsLevel||0,correctCount:c.correctCount||0,incorrectCount:c.incorrectCount||0})),createdAt:new Date().toISOString()};
                    localData.lists.push(list); await saveListToFirestore(list);
                }
                showAlert('✅ Import réussi',`${data.lists.length} liste(s) importée(s) !`,()=>{renderLists();showHomeScreen();});
            });
        } catch(err){showAlert('❌ Erreur','Fichier invalide : '+err.message);}
    };
    reader.readAsText(file); e.target.value='';
});

