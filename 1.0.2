window.showAdminPanel = async () => {
    if (!isAdmin) { showAlert('🚫 Accès refusé','Vous n\'avez pas les droits admin.'); return; }
    showScreen('adminScreen');
    switchAdminTab('users');
    await loadAllUsers();
};

window.switchAdminTab = (tab) => {
    document.getElementById('tabUsers').classList.toggle('active', tab==='users');
    document.getElementById('tabAddAdmin').classList.toggle('active', tab==='addAdmin');
    document.getElementById('adminTabUsers').style.display    = tab==='users'    ? 'block' : 'none';
    document.getElementById('adminTabAddAdmin').style.display = tab==='addAdmin' ? 'block' : 'none';
};

async function loadAllUsers() {
    const container = document.getElementById('userListContainer');
    container.innerHTML = '';
    container.appendChild(createEl('div',{style:{textAlign:'center',padding:'20px',color:'var(--text-light)'}},[createEl('div',{className:'spinner',style:{margin:'0 auto 8px'}},[]),'Chargement des utilisateurs…']));

    try {
        // Récupérer tous les profils dans users/{uid}/profile/data
        const usersSnap = await getDocs(collection(db, 'users'));
        allUsersCache = [];

        for (const userDoc of usersSnap.docs) {
            const uid = userDoc.id;
            try {
                const profileSnap = await getDoc(userProfileRef(uid));
                if (profileSnap.exists()) {
                    const profile = profileSnap.data();
                    // Compter les listes
                    const listsSnap = await getDocs(userListsRef(uid));
                    // Vérifier si admin
                    const adminSnap = await getDoc(adminDocRef(uid));
                    allUsersCache.push({
                        uid,
                        email: profile.email || 'Inconnu',
                        blocked: profile.blocked || false,
                        isAdmin: adminSnap.exists(),
                        lastLogin: profile.lastLogin || null,
                        listsCount: listsSnap.size,
                        totalCards: listsSnap.docs.reduce((acc, d) => acc + ((d.data().cards||[]).length), 0),
                    });
                }
            } catch(e) { console.warn('Erreur lecture profil:', uid, e); }
        }

        renderUserList(allUsersCache);
        updateAdminStats(allUsersCache);
    } catch(e) {
        container.innerHTML = '';
        container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['❌']),createEl('div',{className:'empty-state-title'},['Erreur de chargement']),createEl('p',{},['Vérifiez les règles Firestore : ' + e.message])]));
    }
}

function updateAdminStats(users) {
    setTextSafe('statTotalUsers', users.length);
    setTextSafe('statActiveUsers', users.filter(u => !u.blocked).length);
    setTextSafe('statBlockedUsers', users.filter(u => u.blocked).length);
}

function renderUserList(users) {
    const container = document.getElementById('userListContainer'); container.innerHTML = '';
    if (!users.length) {
        container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['👥']),createEl('div',{className:'empty-state-title'},['Aucun utilisateur trouvé'])]));
        return;
    }
    for (const user of users) {
        const isMe = user.uid === currentUser.uid;
        let cardClass = 'user-card';
        if (user.blocked) cardClass += ' blocked';
        else if (user.isAdmin) cardClass += ' admin-user';

        const card = createEl('div',{className:cardClass});

        // Infos utilisateur
        const userInfo = createEl('div',{className:'user-info'});
        const initiale = (user.email[0] || '?').toUpperCase();
        let avatarClass = 'user-avatar';
        if (user.blocked) avatarClass = 'user-avatar blocked-avatar';
        else if (user.isAdmin) avatarClass = 'user-avatar admin-avatar';
        userInfo.appendChild(createEl('div',{className:avatarClass},[initiale]));

        const details = createEl('div',{className:'user-details'});
        details.appendChild(createEl('div',{className:'user-email'},[user.email + (isMe ? ' (vous)' : '')]));
        const metaText = `${user.listsCount} liste${user.listsCount!==1?'s':''} · ${user.totalCards} carte${user.totalCards!==1?'s':''}`;
        details.appendChild(createEl('div',{className:'user-meta'},[metaText]));
        if (user.lastLogin) details.appendChild(createEl('div',{className:'user-meta'},['Dernière connexion : ' + new Date(user.lastLogin).toLocaleDateString('fr-FR')]));

        // Badges
        const badges = createEl('div',{className:'user-badges'});
        if (user.isAdmin) badges.appendChild(createEl('span',{className:'badge badge-admin'},['🛡️ Admin']));
        if (user.blocked) badges.appendChild(createEl('span',{className:'badge badge-blocked'},['🚫 Bloqué']));
        else badges.appendChild(createEl('span',{className:'badge badge-active'},['✓ Actif']));
        details.appendChild(badges);

        userInfo.appendChild(details);
        card.appendChild(userInfo);

        // UID (copiable)
        const uidEl = createEl('div',{style:{fontSize:'11px',color:'var(--text-light)',marginBottom:'10px',wordBreak:'break-all',cursor:'pointer',display:'flex',alignItems:'center',gap:'4px'},onClick:()=>{
            navigator.clipboard?.writeText(user.uid);
            showAlert('✅ Copié','UID copié dans le presse-papiers.');
        }},['🔑 UID : ' + user.uid.substring(0,20) + '…']);
        card.appendChild(uidEl);

        // Actions
        if (!isMe) {
            const actions = createEl('div',{className:'card-actions'});

            // Voir les listes
            actions.appendChild(createEl('button',{className:'btn btn-secondary btn-sm',onClick:()=>viewUserLists(user)},['📋 Listes']));

            // Bloquer / Débloquer
            if (user.blocked) {
                actions.appendChild(createEl('button',{className:'btn btn-success btn-sm',onClick:()=>toggleBlockUser(user,false)},['✓ Débloquer']));
            } else {
                actions.appendChild(createEl('button',{className:'btn btn-warning btn-sm',onClick:()=>toggleBlockUser(user,true)},['🚫 Bloquer']));
            }

            // Révoquer admin (si admin mais pas soi-même)
            if (user.isAdmin) {
                actions.appendChild(createEl('button',{className:'btn btn-danger btn-sm',onClick:()=>revokeAdmin(user)},['🛡️ Révoquer admin']));
            }

            card.appendChild(actions);
        } else {
            card.appendChild(createEl('div',{style:{fontSize:'12px',color:'var(--text-light)',marginTop:'8px',fontStyle:'italic'}},['C\'est vous — actions désactivées']));
        }

        container.appendChild(card);
    }
}

// Filtre utilisateurs
window.filterUsers = () => {
    const query = document.getElementById('userSearchInput').value.toLowerCase().trim();
    const filtered = allUsersCache.filter(u => u.email.toLowerCase().includes(query) || u.uid.toLowerCase().includes(query));
    renderUserList(filtered);
};

// Bloquer / Débloquer
async function toggleBlockUser(user, block) {
    const action = block ? 'bloquer' : 'débloquer';
    showConfirm(
        block ? '🚫 Bloquer l\'utilisateur' : '✓ Débloquer l\'utilisateur',
        `Voulez-vous ${action} ${user.email} ?\n${block ? 'Il ne pourra plus se connecter.' : 'Il pourra à nouveau se connecter.'}`,
        async () => {
            try {
                await updateDoc(userProfileRef(user.uid), { blocked: block });
                // Mettre à jour le cache
                const u = allUsersCache.find(u2 => u2.uid === user.uid);
                if (u) u.blocked = block;
                renderUserList(allUsersCache);
                updateAdminStats(allUsersCache);
                showAlert('✅ Succès', `Utilisateur ${block ? 'bloqué' : 'débloqué'} avec succès.`);
            } catch(e) {
                showAlert('❌ Erreur', 'Impossible de modifier : ' + e.message);
            }
        }
    );
}

// Accorder droits admin
window.grantAdmin = async () => {
    const uid = document.getElementById('newAdminUid').value.trim();
    if (!uid) { showAlert('⚠️ Champ vide','Entrez un UID.'); return; }
    if (uid === currentUser.uid) { showAlert('⚠️ Impossible','Vous êtes déjà admin.'); return; }

    // Vérifier que l'utilisateur existe
    const profileSnap = await getDoc(userProfileRef(uid));
    if (!profileSnap.exists()) { showAlert('❌ Introuvable','Aucun utilisateur avec cet UID.'); return; }

    const email = profileSnap.data().email || 'cet utilisateur';
    showConfirm('🛡️ Accorder admin', `Accorder les droits admin à ${email} ?`, async () => {
        try {
            await setDoc(adminDocRef(uid), { grantedBy: currentUser.uid, grantedAt: new Date().toISOString() });
            document.getElementById('newAdminUid').value = '';
            showAlert('✅ Succès', `${email} est maintenant admin.`, () => loadAllUsers());
        } catch(e) {
            showAlert('❌ Erreur', 'Impossible : ' + e.message);
        }
    });
};

// Révoquer droits admin
async function revokeAdmin(user) {
    showConfirm('🛡️ Révoquer admin', `Retirer les droits admin de ${user.email} ?`, async () => {
        try {
            await deleteDoc(adminDocRef(user.uid));
            const u = allUsersCache.find(u2 => u2.uid === user.uid);
            if (u) u.isAdmin = false;
            renderUserList(allUsersCache);
            showAlert('✅ Succès', `Droits admin révoqués pour ${user.email}.`);
        } catch(e) {
            showAlert('❌ Erreur', 'Impossible : ' + e.message);
        }
    });
}

// Voir les listes d'un utilisateur
async function viewUserLists(user) {
    adminViewingUser = user;
    setTextSafe('adminDetailUserEmail', user.email);
    setTextSafe('adminDetailTitle', `📋 Listes de ${user.email}`);

    const container = document.getElementById('adminUserListsContainer'); container.innerHTML = '';
    container.appendChild(createEl('div',{style:{textAlign:'center',padding:'20px',color:'var(--text-light)'}},[createEl('div',{className:'spinner',style:{margin:'0 auto 8px'}},[]),'Chargement…']));
    showScreen('adminUserDetailScreen');

    try {
        const listsSnap = await getDocs(userListsRef(user.uid));
        container.innerHTML = '';
        if (listsSnap.empty) {
            container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['📋']),createEl('div',{className:'empty-state-title'},['Aucune liste']),createEl('p',{},['Cet utilisateur n\'a pas encore créé de listes.'])]));
            return;
        }
        listsSnap.docs.forEach(docSnap => {
            const list = { id: docSnap.id, ...docSnap.data() };
            const cards = list.cards || [];
            const card = createEl('div',{className:'card'});
            card.appendChild(createEl('div',{className:'card-title'},[list.name]));
            card.appendChild(createEl('div',{className:'card-info',style:{marginTop:'4px'}},[`${cards.length} carte${cards.length!==1?'s':''}`]));
            const actions = createEl('div',{className:'card-actions'});
            actions.appendChild(createEl('button',{className:'btn btn-secondary btn-sm',onClick:()=>viewUserListDetail(list)},['👁️ Voir les cartes']));
            actions.appendChild(createEl('button',{className:'btn btn-danger btn-sm',onClick:()=>adminDeleteList(user,list,container,listsSnap)},['🗑️ Supprimer']));
            card.appendChild(actions);
            container.appendChild(card);
        });
    } catch(e) {
        container.innerHTML = '';
        container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['❌']),createEl('p',{},['Erreur : ' + e.message])]));
    }
}

function viewUserListDetail(list) {
    adminViewingList = list;
    setTextSafe('adminListDetailTitle', `🃏 ${list.name}`);
    const container = document.getElementById('adminListCardsContainer'); container.innerHTML = '';
    const cards = list.cards || [];
    if (!cards.length) {
        container.appendChild(createEl('div',{className:'empty-state'},[createEl('div',{className:'empty-state-icon'},['🃏']),createEl('div',{className:'empty-state-title'},['Liste vide'])]));
    } else {
        for (const card of cards) {
            const el = createEl('div',{className:'card',style:{padding:'12px'}});
            el.appendChild(createEl('div',{style:{fontWeight:'600',marginBottom:'4px'}},[card.front]));
            el.appendChild(createEl('div',{style:{color:'var(--text-light)',fontSize:'13px'}},['→ '+card.back]));
            if (card.frontComment) el.appendChild(createEl('div',{style:{color:'var(--text-light)',fontSize:'12px',fontStyle:'italic',marginTop:'4px'}},[card.frontComment]));
            el.appendChild(createEl('div',{style:{fontSize:'11px',color:'var(--text-light)',marginTop:'4px'}},[`✓ ${card.correctCount||0}  ✕ ${card.incorrectCount||0}`]));
            container.appendChild(el);
        }
    }
    showScreen('adminListDetailScreen');
}

window.backToUserDetail = () => { if (adminViewingUser) viewUserLists(adminViewingUser); else showAdminPanel(); };

async function adminDeleteList(user, list, container) {
    showConfirm('🗑️ Supprimer la liste', `Supprimer "${list.name}" de ${user.email} ?`, async () => {
        try {
            await deleteListFromFirestore(list.id, user.uid);
            showAlert('✅ Supprimé', `La liste "${list.name}" a été supprimée.`, () => viewUserLists(user));
        } catch(e) {
            showAlert('❌ Erreur', 'Impossible de supprimer : ' + e.message);
        }
    });
}

// ── Misc ──────────────────────────────────────────────────────
document.querySelectorAll('.modal').forEach(m => m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('active');}));
document.getElementById('dialogOverlay').addEventListener('click',e=>{if(e.target.id==='dialogOverlay')closeDialog();});
document.getElementById('listName').addEventListener('keydown',e=>{if(e.key==='Enter')window.createList();});
document.addEventListener('keydown',e=>{
    if(!document.getElementById('learningScreen').classList.contains('active'))return;
    if(e.key===' '||e.key==='Enter'){e.preventDefault();window.flipCard();}
    if(e.key==='ArrowRight')window.nextCard();
    if(e.key==='ArrowLeft')window.previousCard();
    if(e.key==='ArrowUp')window.markCardCorrect();
    if(e.key==='ArrowDown')window.markCardIncorrect();
});

</script>
</body>
</html>
